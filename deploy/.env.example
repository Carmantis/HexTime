# Settings for deploy/compose.yaml. Copy to deploy/.env and fill in.
# (On a real server the installation script writes these for you.)

# The address people open, without https://.
HEXTIME_DOMAIN=localhost
# Only these addresses can have an account.
ALLOWED_EMAIL_DOMAIN=example.org

# Long random values. Make them with:  openssl rand -base64 48
SECRET_KEY=
POSTGRES_PASSWORD=

# Mail for invitations and password links. SMTP_HOST=console prints the
# emails in the log instead, for trying it out.
SMTP_HOST=console
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

DEFAULT_LOCALE=fi
# Team reports count whole days in this zone.
TIME_ZONE=Europe/Helsinki

# Trying it on a laptop where 80 and 443 are taken or need root:
# HTTP_PORT=8080
# HTTPS_PORT=8443
# HTTPS_PORT_SUFFIX=:8443
